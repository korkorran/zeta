# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A format and a algorithm to parse the command line"
description:
  "A format describing the syntax of terminal commands, and an algorithm `Zeta` to evaluate a terminal entry to a formatted representation of the entry. The evaluation is done against a collection of description of command saved in a registry. The project aims to be a general approach to parse terminal entries despites the variety of terminal commands syntax."
maintainer: ["Frédéric Lang <frederic.ln.lang@gmail.com>"]
authors: ["Frédéric Lang <frederic.ln.lang@gmail.com>"]
license: "AGPL-3.0-or-later"
tags: ["command" "terminal" "parser" "format" "ocaml"]
homepage: "https://github.com/korkorran/zeta"
doc: "https://url/to/documentation"
bug-reports: "https://github.com/korkorran/zeta/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml"
  "cmdliner"
  "lambda-term"
  "lwt"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/korkorran/zeta.git"
